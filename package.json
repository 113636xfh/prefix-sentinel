{
  "name": "prefix-sentinel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Observation-only pi extension: diffs every provider request against the previous one to reveal prefix changes.",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/",
    "docs:render": "node docs/render.mjs",
    "docs:verify": "node docs/verify.mjs 01-loop 02-verdict",
    "docs:probe": "node docs/probe-pixels.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.9",
    "@types/node": "^26.0.0",
    "typescript": "^5.8.3"
  }
}
